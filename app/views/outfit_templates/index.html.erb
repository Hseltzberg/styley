<div style="max-width: 1100px; margin: 0 auto; padding: 32px 20px 16px;">
  <div style="margin-bottom: 28px;">
    <h1 style="font-family: 'Playfair Display', serif; font-size: 2.2rem; color: #3d0a28; margin-bottom: 4px;">
      <%= (current_user.username.presence || current_user.email.split("@").first) %>'s closet
    </h1>
    <% if @list_of_outfits.count > 0 %>
      <p style="color: #7B2C00; font-size: 1rem; opacity: 0.8;">You've got great taste.</p>
    <% else %>
      <p style="color: #7B2C00; font-size: 1rem; opacity: 0.8;"><a href="/outfits/new" style="color: #7B2C00;">Start building your closet →</a></p>
    <% end %>
  </div>
</div>

<div style="max-width: 1100px; margin: 0 auto; padding: 0 20px 80px;">

<%# if @list_of_outfits.count > 1 %>
<% any_filters_active = @selected_season_names.count > 0 || @selected_feeling_names.count > 0 || @selected_occasion_names.count > 0 %>

<% if current_user.outfit_uploads.count > 0 && !any_filters_active %>
  <div style="margin-bottom: 28px;">
    <p style="font-family: 'Playfair Display', serif; font-size: 1.05rem; color: #3d0a28; font-style: italic; margin-bottom: 14px;">How do you want to feel today?</p>
    <div style="display: flex; flex-wrap: wrap; gap: 8px;">
      <% @list_of_feelings.each do |f| %>
        <a href="/outfits?feelings[]=<%= f.id %>"
           style="padding: 7px 18px; border-radius: 999px; background: #F3E9DC; border: 1px solid #A3BACB; color: #7B2C00; font-size: 0.875rem; text-decoration: none; transition: background 0.15s, color 0.15s, border-color 0.15s;"
           onmouseover="this.style.background='#7B2C00';this.style.color='white';this.style.borderColor='#7B2C00'"
           onmouseout="this.style.background='#F3E9DC';this.style.color='#7B2C00';this.style.borderColor='#A3BACB'">
          <%= f.name %>
        </a>
      <% end %>
    </div>
  </div>
<% end %>

<% if current_user.outfit_uploads.count > 0 %>
  <div style="margin-bottom: 20px;">
    <a href="#" id="surprise-btn"
       style="display: inline-block; padding: 12px 32px; border-radius: 999px; background: #7B2C00; color: white; text-decoration: none; font-size: 0.95rem; font-weight: 500; box-shadow: 0 4px 16px rgba(123,44,0,0.25); transition: transform 0.15s, box-shadow 0.15s;"
       onmouseover="this.style.transform='translateY(-2px)';this.style.boxShadow='0 8px 24px rgba(123,44,0,0.35)'"
       onmouseout="if(!this.dataset.active){this.style.transform='';this.style.boxShadow='0 4px 16px rgba(123,44,0,0.25)'}">
      Surprise me ✨
    </a>
  </div>
<% end %>

<button
    class="btn btn-outline-primary"
    id="filter_toggle"
    type="button"
    data-bs-toggle="collapse"
    data-bs-target="#filter_box"
    aria-expanded="<%= any_filters_active %>"
    aria-controls="filter_box">
  Filter
</button>

<div id="filter_box" class="collapse mt-3 <%= 'show' if any_filters_active %>">
  <form id="filter_form" action="/outfits" method="get">

    <p class="filter-section-label">Season</p>
    <div class="category-chips">
      <label class="category-chip">
        <input type="checkbox" name="query_season_fall" value="fall" <%= "checked" if @selected_season_names.include?("fall") %>>
        Fall
      </label>
      <label class="category-chip">
        <input type="checkbox" name="query_season_winter" value="winter" <%= "checked" if @selected_season_names.include?("winter") %>>
        Winter
      </label>
      <label class="category-chip">
        <input type="checkbox" name="query_season_spring" value="spring" <%= "checked" if @selected_season_names.include?("spring") %>>
        Spring
      </label>
      <label class="category-chip">
        <input type="checkbox" name="query_season_summer" value="summer" <%= "checked" if @selected_season_names.include?("summer") %>>
        Summer
      </label>
    </div>

    <p class="filter-section-label">Feeling</p>
    <select id="feeling-select" name="feelings[]" multiple placeholder="e.g. confident, cozy...">
      <% @list_of_feelings.each do |a_feeling| %>
        <option value="<%= a_feeling.id %>" <%= "selected" if @selected_feeling_ids.include?(a_feeling.id.to_s) %>><%= a_feeling.name %></option>
      <% end %>
    </select>

    <p class="filter-section-label">Occasion</p>
    <select id="occasion-select" name="occasions[]" multiple placeholder="e.g. work, date night...">
      <% @list_of_occasions.each do |an_occasion| %>
        <option value="<%= an_occasion.id %>" <%= "selected" if @selected_occasion_names.include?(an_occasion.name) %>><%= an_occasion.name %></option>
      <% end %>
    </select>

    <div class="mt-3">
      <button type="submit" class="btn btn-outline-primary btn-sm" name="query_mode" value="surprise" id="surprise-filtered-btn">Surprise me within these filters ✨</button>
    </div>
  </form>
</div>

<script>
  document.querySelectorAll('#filter_form input[type="checkbox"]').forEach(function(cb) {
    cb.addEventListener('change', function() {
      document.getElementById('filter_form').submit();
    });
  });

  ['feeling-select', 'occasion-select'].forEach(function(id) {
    new TomSelect('#' + id, {
      plugins: ['remove_button'],
      onChange: function() {
        document.getElementById('filter_form').submit();
      }
    });
  });

  var surpriseBtn = document.getElementById('surprise-btn');
  if (surpriseBtn) {
    surpriseBtn.addEventListener('click', function(e) {
      e.preventDefault();
      var btn = this;
      btn.dataset.active = '1';
      btn.textContent = 'Finding your look...';
      btn.style.opacity = '0.7';
      btn.style.transform = 'scale(0.97)';
      var form = document.getElementById('filter_form');
      var hidden = document.createElement('input');
      hidden.type = 'hidden';
      hidden.name = 'query_mode';
      hidden.value = 'surprise';
      form.appendChild(hidden);
      setTimeout(function() { form.submit(); }, 420);
    });
  }

  document.addEventListener('DOMContentLoaded', function() {
    if (typeof ColorThief === 'undefined') return;
    var ct = new ColorThief();
    document.querySelectorAll('.pin-image[data-palette]').forEach(function(img) {
      var bar = document.getElementById(img.dataset.palette);
      if (!bar) return;
      function extract() {
        try {
          var palette = ct.getPalette(img, 5);
          palette.forEach(function(c) {
            var s = document.createElement('div');
            s.style.flex = '1';
            s.style.background = 'rgb(' + c[0] + ',' + c[1] + ',' + c[2] + ')';
            bar.appendChild(s);
          });
          bar.style.opacity = '1';
        } catch(e) {}
      }
      if (img.complete && img.naturalWidth > 0) { extract(); }
      else { img.addEventListener('load', extract); }
    });
  });
</script>

  <% if @list_of_outfits.count == 0 %>
    <div class="empty_state_box">
      <p><strong>No fits matched this vibe yet.</strong></p>
      <p>Try changing a filter, or add a new outfit for future-you.</p>
      <p>
        <a href="/outfits">Clear all filters</a>
      </p>
      <p>
        <a href="/outfits/new">Add a new outfit</a>
      </p>
    </div>
  <% else %>
    <% if @selected_season_names.count > 0 || @selected_feeling_names.count > 0 || @selected_occasion_names.count > 0 %>
      <div class="active_filters_box">
        <p><strong>Your current vibe:</strong></p>

        <% @selected_season_names.each do |a_season_name| %>
          <span class="filter_chip"><%= a_season_name %></span>
        <% end %>

        <% @selected_feeling_names.each do |a_feeling_name| %>
          <span class="filter_chip"><%= a_feeling_name %></span>
        <% end %>

        <% @selected_occasion_names.each do |an_occasion_name| %>
          <span class="filter_chip"><%= an_occasion_name %></span>
        <% end %>
        <p>
          <a href="/outfits">Clear filters</a>
        </p>
      </div>
    <% end %>

    <div class="pin-board">
      <% @list_of_outfits.each do |an_outfit| %>
        <div class="pin-card <%= an_outfit.card_size %>" onclick="location.href='/outfits/<%= an_outfit.id %>'">
          <img class="pin-image" src="<%= an_outfit.outfit_photo_url %>" crossorigin="anonymous" data-palette="palette-<%= an_outfit.id %>">
          <div class="pin-overlay">
            <h3 class="pin-headline"><%= an_outfit.note_headline %></h3>
            <a class="pin-view-link" href="/outfits/<%= an_outfit.id %>">view outfit</a>
          </div>
          <div id="palette-<%= an_outfit.id %>" style="position: absolute; bottom: 0; left: 0; right: 0; height: 5px; display: flex; opacity: 0; transition: opacity 0.5s ease; z-index: 3;"></div>
        </div>
      <% end %>
    </div>

  <% end %>

</div>
