<div style="min-height: 80vh; display: flex; align-items: center; justify-content: center; padding: 40px 20px;">
  <div style="background: white; border-radius: 24px; padding: 48px 40px; box-shadow: 0 4px 24px rgba(139,26,74,0.1); width: 100%; max-width: 440px;">

    <div style="text-align: center; margin-bottom: 36px;">
      <h1 style="font-family: 'Playfair Display', serif; font-size: 1.8rem; color: #3d0a28; font-style: italic; margin-bottom: 6px;">Welcome back.</h1>
      <p style="color: #8b1a4a; font-size: 0.9rem; opacity: 0.75;">Log in to your closet.</p>
    </div>

    <%= form_for(resource, { :as => resource_name, :url => session_path(resource_name) }) do |f| %>
      <div class="mb-3">
        <label for="email_field" class="form-label" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; color: #8b1a4a; font-weight: 600;">Email</label>
        <%= f.email_field(:email, { :autofocus => true, :autocomplete => "email", :class => "form-control", :id => "email_field", :style => "border-radius: 12px; padding: 12px 16px;" }) %>
      </div>

      <div class="mb-4">
        <label for="password_field" class="form-label" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; color: #8b1a4a; font-weight: 600;">Password</label>
        <%= f.password_field(:password, { :autocomplete => "current-password", :class => "form-control", :id => "password_field", :style => "border-radius: 12px; padding: 12px 16px;" }) %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="form-check mb-3">
          <%= f.check_box(:remember_me, { :class => "form-check-input", :id => "remember_me_field" }) %>
          <label for="remember_me_field" class="form-check-label" style="font-size: 0.9rem; color: #555;">Remember me</label>
        </div>
      <% end %>

      <div class="d-grid">
        <%= f.submit("Log in", { :class => "btn btn-primary", :style => "border-radius: 999px; padding: 12px 32px; width: 100%; font-size: 1rem;" }) %>
      </div>
    <% end %>

    <div class="mt-4" style="text-align: center; font-size: 0.88rem;">
      <%= render("devise/shared/links") %>
    </div>
  </div>
</div>
