<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <h2 class="mb-4" style="font-family: 'Playfair Display', serif; color: #1e2d26;">Edit Profile</h2>

      <%= form_for(resource, { :as => resource_name, :url => registration_path(resource_name), :html => { :method => :put } }) do |f| %>
        <%= render("devise/shared/error_messages", { :resource => resource }) %>

        <div class="mb-3">
          <label for="email_field" class="form-label">Email</label>
          <%= f.email_field(:email, { :autofocus => true, :autocomplete => "email", :class => "form-control", :id => "email_field" }) %>
        </div>

        <div class="mb-3">
          <label for="username_field" class="form-label">Username</label>
          <%= f.text_field(:username, { :class => "form-control", :id => "username_field" }) %>
        </div>

        <div class="mb-3">
          <label for="password_field" class="form-label">New password</label>
          <%= f.password_field(:password, { :autocomplete => "new-password", :class => "form-control", :id => "password_field" }) %>
        </div>

        <div class="mb-3">
          <label for="password_confirmation_field" class="form-label">Password confirmation</label>
          <%= f.password_field(:password_confirmation, { :autocomplete => "new-password", :class => "form-control", :id => "password_confirmation_field" }) %>
        </div>

        <div class="mb-3">
          <label for="style_description_field" class="form-label">Your style influences</label>
          <small class="d-block text-muted mb-1">Who or what inspires you? We'll use this to find inspiration that matches your taste.</small>
          <%= f.text_area(:style_description, {
            :class => "form-control",
            :id => "style_description_field",
            :rows => 3,
            :placeholder => "e.g. Diane Keaton in the 70s, French minimalism, thrift store finds, old money but make it fun"
          }) %>
        </div>

        <div class="mb-3">
          <label for="current_password_field" class="form-label">Current password</label>
          <%= f.password_field(:current_password, { :autocomplete => "current-password", :class => "form-control", :id => "current_password_field" }) %>
        </div>

        <div class="d-grid">
          <%= f.submit("Update account", { :class => "btn btn-primary", :style => "border-radius: 999px; padding: 10px 32px; width: 100%;" }) %>
        </div>
      <% end %>
    </div>
  </div>
</div>
