<div style="max-width: 560px; margin: 48px auto; padding: 0 20px 80px;">
  <div style="background: white; border-radius: 24px; padding: 48px 40px; box-shadow: 0 4px 24px rgba(139,26,74,0.1);">

    <div style="margin-bottom: 36px;">
      <h1 style="font-family: 'Playfair Display', serif; font-size: 1.8rem; color: #3d0a28; margin-bottom: 4px;">Edit Profile</h1>
      <p style="color: #8b1a4a; font-size: 0.9rem; opacity: 0.75;">Update your account details.</p>
    </div>

    <%= form_for(resource, { :as => resource_name, :url => registration_path(resource_name), :html => { :method => :put } }) do |f| %>
      <%= render("devise/shared/error_messages", { :resource => resource }) %>

      <div class="mb-3">
        <label for="email_field" class="form-label" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; color: #8b1a4a; font-weight: 600;">Email</label>
        <%= f.email_field(:email, { :autofocus => true, :autocomplete => "email", :class => "form-control", :id => "email_field", :style => "border-radius: 12px; padding: 12px 16px;" }) %>
      </div>

      <div class="mb-3">
        <label for="username_field" class="form-label" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; color: #8b1a4a; font-weight: 600;">Username</label>
        <%= f.text_field(:username, { :class => "form-control", :id => "username_field", :style => "border-radius: 12px; padding: 12px 16px;" }) %>
      </div>

      <div class="mb-3">
        <label for="style_description_field" class="form-label" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; color: #8b1a4a; font-weight: 600;">Your style influences</label>
        <small class="d-block mb-1" style="color: #999; font-size: 0.82rem;">Who or what inspires you? We'll use this to personalise your inspiration.</small>
        <%= f.text_area(:style_description, {
          :class => "form-control",
          :id => "style_description_field",
          :rows => 3,
          :placeholder => "e.g. Diane Keaton in the 70s, French minimalism, thrift store finds, old money but make it fun",
          :style => "border-radius: 12px; padding: 12px 16px; resize: vertical;"
        }) %>
      </div>

      <hr style="border-color: #f0e8e4; margin: 28px 0;">

      <div class="mb-3">
        <label for="password_field" class="form-label" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; color: #8b1a4a; font-weight: 600;">New password</label>
        <small class="d-block mb-1" style="color: #999; font-size: 0.82rem;">Leave blank to keep your current password.</small>
        <%= f.password_field(:password, { :autocomplete => "new-password", :class => "form-control", :id => "password_field", :style => "border-radius: 12px; padding: 12px 16px;" }) %>
      </div>

      <div class="mb-4">
        <label for="password_confirmation_field" class="form-label" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; color: #8b1a4a; font-weight: 600;">Confirm new password</label>
        <%= f.password_field(:password_confirmation, { :autocomplete => "new-password", :class => "form-control", :id => "password_confirmation_field", :style => "border-radius: 12px; padding: 12px 16px;" }) %>
      </div>

      <div class="mb-4">
        <label for="current_password_field" class="form-label" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; color: #8b1a4a; font-weight: 600;">Current password <span style="color: #c9956a;">*required</span></label>
        <small class="d-block mb-1" style="color: #999; font-size: 0.82rem;">Required to save any changes.</small>
        <%= f.password_field(:current_password, { :autocomplete => "current-password", :class => "form-control", :id => "current_password_field", :style => "border-radius: 12px; padding: 12px 16px;" }) %>
      </div>

      <div class="d-grid">
        <%= f.submit("Save changes", { :class => "btn btn-primary", :style => "border-radius: 999px; padding: 12px 32px; width: 100%; font-size: 1rem;" }) %>
      </div>
    <% end %>
  </div>
</div>
