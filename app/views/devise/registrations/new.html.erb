<div style="min-height: 80vh; display: flex; align-items: center; justify-content: center; padding: 40px 20px;">
  <div style="background: white; border-radius: 24px; padding: 48px 40px; box-shadow: 0 4px 24px rgba(139,26,74,0.1); width: 100%; max-width: 480px;">

    <div style="text-align: center; margin-bottom: 36px;">
      <h1 style="font-family: 'Playfair Display', serif; font-size: 1.8rem; color: #3d0a28; font-style: italic; margin-bottom: 6px;">Dress with intention.</h1>
      <p style="color: #8b1a4a; font-size: 0.9rem; opacity: 0.75;">Create your Styley account.</p>
    </div>

    <%= form_for(resource, { :as => resource_name, :url => registration_path(resource_name) }) do |f| %>
      <%= render("devise/shared/error_messages", { :resource => resource }) %>

      <div class="mb-3">
        <label for="email_field" class="form-label" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; color: #8b1a4a; font-weight: 600;">Email</label>
        <%= f.email_field(:email, { :autofocus => true, :autocomplete => "email", :class => "form-control", :id => "email_field", :style => "border-radius: 12px; padding: 12px 16px;" }) %>
      </div>

      <div class="mb-3">
        <label for="username_field" class="form-label" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; color: #8b1a4a; font-weight: 600;">Username</label>
        <%= f.text_field(:username, { :class => "form-control", :id => "username_field", :style => "border-radius: 12px; padding: 12px 16px;" }) %>
      </div>

      <div class="mb-3">
        <label for="password_field" class="form-label" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; color: #8b1a4a; font-weight: 600;">
          Password
          <% if @minimum_password_length %>
            <span style="font-weight: 400; text-transform: none; letter-spacing: 0; font-size: 0.8rem; color: #999;">(<%= @minimum_password_length %> characters minimum)</span>
          <% end %>
        </label>
        <%= f.password_field(:password, { :autocomplete => "new-password", :class => "form-control", :id => "password_field", :style => "border-radius: 12px; padding: 12px 16px;" }) %>
      </div>

      <div class="mb-3">
        <label for="password_confirmation_field" class="form-label" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; color: #8b1a4a; font-weight: 600;">Confirm password</label>
        <%= f.password_field(:password_confirmation, { :autocomplete => "new-password", :class => "form-control", :id => "password_confirmation_field", :style => "border-radius: 12px; padding: 12px 16px;" }) %>
      </div>

      <div class="mb-4">
        <label for="style_description_field" class="form-label" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; color: #8b1a4a; font-weight: 600;">Your style influences</label>
        <small class="d-block mb-1" style="color: #999; font-size: 0.82rem;">Who or what inspires you? Think people, eras, aesthetics, vibes. We'll use this to personalise your inspiration.</small>
        <%= f.text_area(:style_description, {
          :class => "form-control",
          :id => "style_description_field",
          :rows => 3,
          :placeholder => "e.g. Diane Keaton in the 70s, French minimalism, thrift store finds, old money but make it fun",
          :style => "border-radius: 12px; padding: 12px 16px; resize: vertical;"
        }) %>
      </div>

      <div class="d-grid">
        <%= f.submit("Get started", { :class => "btn btn-primary", :style => "border-radius: 999px; padding: 12px 32px; width: 100%; font-size: 1rem;" }) %>
      </div>
    <% end %>

    <div class="mt-4" style="text-align: center; font-size: 0.88rem;">
      <%= render("devise/shared/links") %>
    </div>
  </div>
</div>
