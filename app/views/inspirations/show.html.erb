<div id="inspo-loading" class="inspo-loading-overlay" style="display:none;">
  <div class="inspo-loading-inner">
    <div class="inspo-loading-dots">
      <span></span><span></span><span></span>
    </div>
    <p id="inspo-loading-message" class="inspo-loading-message">Consulting the archives...</p>
  </div>
</div>

<div class="inspiration-page">

  <div class="inspiration-header">
    <h1 class="inspiration-title">Get Inspired</h1>
    <% if current_user.style_description.present? %>
      <p class="inspiration-style-echo">Styling based on your taste: <em><%= current_user.style_description.truncate(90) %></em></p>
    <% else %>
      <p class="inspiration-style-echo">
        <a href="/users/edit">Add your style influences</a> to get more personal results.
      </p>
    <% end %>
  </div>

  <form action="/inspiration" method="post" class="inspiration-form" id="filter_form">
    <%= hidden_field_tag :authenticity_token, form_authenticity_token %>

    <div class="inspiration-context-row">
      <div class="inspiration-select-group">
        <label class="filter-section-label">I want to feel</label>
        <select name="feeling_id" class="form-select">
          <option value="">Any feeling</option>
          <% @list_of_feelings.each do |f| %>
            <option value="<%= f.id %>" <%= "selected" if @feeling&.id == f.id %>><%= f.name %></option>
          <% end %>
        </select>
      </div>

      <div class="inspiration-select-group">
        <label class="filter-section-label">For</label>
        <select name="occasion_id" class="form-select">
          <option value="">Any occasion</option>
          <% @list_of_occasions.each do |o| %>
            <option value="<%= o.id %>" <%= "selected" if @occasion&.id == o.id %>><%= o.name %></option>
          <% end %>
        </select>
      </div>

      <div class="inspiration-select-group">
        <label class="filter-section-label">In the</label>
        <select name="season" class="form-select">
          <option value="">Any season</option>
          <% ["fall", "winter", "spring", "summer"].each do |s| %>
            <option value="<%= s %>" <%= "selected" if @season == s %>><%= s.capitalize %></option>
          <% end %>
        </select>
      </div>

      <div class="inspiration-select-group d-flex align-items-end">
        <button type="submit" class="btn btn-primary w-100">Generate</button>
      </div>
    </div>
  </form>

  <script>
    (function() {
      var messages = [
        "Dressing for you, now...",
        "Consulting the archives...",
        "“Fashion you can buy, but style you possess. The key to style is learning who you are, which takes years. There’s no how-to road map to style. It’s about self expression and, above all, attitude.” —Iris Apfel",
        "Finding your editorial moment...",
        "Curating with intention...",
        "“The joy of dressing is an art.” —John Galliano",
        "“We are multifaceted and we’re not always the same… it’s important to portray that.” —Chemena Kamali"
      ];

      function shuffleArray(arr) {
        for (var i = arr.length - 1; i > 0; i--) {
          var j = Math.floor(Math.random() * (i + 1));
          var tmp = arr[i]; arr[i] = arr[j]; arr[j] = tmp;
        }
        return arr;
      }

      var form = document.getElementById("filter_form");
      if (form) {
        form.addEventListener("submit", function() {
          shuffleArray(messages);
          var overlay = document.getElementById("inspo-loading");
          var messageEl = document.getElementById("inspo-loading-message");
          overlay.style.display = "flex";

          var i = -1;
          setInterval(function() {
            i++;
            if (i >= messages.length) {
              shuffleArray(messages);
              i = 0;
            }
            messageEl.style.opacity = "0";
            setTimeout(function() {
              messageEl.textContent = messages[i];
              messageEl.style.opacity = "1";
            }, 300);
          }, 12000);
        });
      }
    })();
  </script>

  <% if @inspirations.any? %>
    <div class="inspo-results">
      <% @inspirations.each_with_index do |inspo, i| %>
        <%= render "inspo_card", inspo: inspo, index: i, feeling_id: params[:feeling_id], occasion_id: params[:occasion_id], season: params[:season] %>
      <% end %>
    </div>

  <% elsif params[:feeling_id].present? || params[:occasion_id].present? || params[:season].present? %>
    <% if ENV["AICHAT_PROXY_KEY"].blank? && ENV["OPENAI_API_KEY"].blank? %>
      <div class="inspo-empty">
        <p><strong>Almost there.</strong> Add your <code>OPENAI_API_KEY</code> to <code>.env</code> to activate inspiration generation.</p>
      </div>
    <% else %>
      <div class="inspo-empty">
        <p>Couldn't generate inspiration right now. Try again in a moment.</p>
      </div>
    <% end %>
  <% end %>

</div>
