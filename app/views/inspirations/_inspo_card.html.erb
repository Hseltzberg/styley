<%= turbo_frame_tag "inspo_card_#{index}" do %>
  <div class="inspo-card">
    <form action="/inspiration/regenerate" method="post" class="inspo-regen-form">
      <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
      <input type="hidden" name="feeling_id"  value="<%= feeling_id %>">
      <input type="hidden" name="occasion_id" value="<%= occasion_id %>">
      <input type="hidden" name="season"      value="<%= season %>">
      <input type="hidden" name="index"       value="<%= index %>">
      <button type="submit" class="inspo-regen-btn" title="Regenerate">
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
          <path d="M3 3v5h5"/>
        </svg>
      </button>
    </form>

    <div class="inspo-palette-bar">
      <% (inspo["color_palette"] || []).each do |color| %>
        <span class="inspo-swatch" style="background-color: <%= color %>;"></span>
      <% end %>
    </div>

    <div class="inspo-body">
      <p class="inspo-reference">
        <a href="https://www.google.com/search?q=<%= CGI.escape(inspo["editorial_reference"].to_s) %>&tbm=isch" target="_blank" rel="noopener noreferrer"><%= inspo["editorial_reference"] %></a>
      </p>
      <h2 class="inspo-concept-title"><%= inspo["title"] %></h2>

      <div class="inspo-pieces">
        <% (inspo["key_pieces"] || []).each do |piece| %>
          <span class="inspo-piece-chip"><%= piece %></span>
        <% end %>
      </div>

      <form action="/pin-inspiration" method="post" class="mt-3">
        <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
        <input type="hidden" name="title"               value="<%= inspo["title"] %>">
        <input type="hidden" name="editorial_reference" value="<%= inspo["editorial_reference"] %>">
        <input type="hidden" name="description"         value="<%= inspo["description"] %>">
        <input type="hidden" name="why_timeless"        value="<%= inspo["why_timeless"] %>">
        <input type="hidden" name="color_palette"       value="<%= inspo["color_palette"].to_json %>">
        <input type="hidden" name="key_pieces"          value="<%= inspo["key_pieces"].to_json %>">
        <button type="submit" class="btn btn-sm inspo-pin-btn">Pin to mood board</button>
      </form>
    </div>
  </div>
<% end %>
