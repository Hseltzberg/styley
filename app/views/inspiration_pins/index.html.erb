<div class="inspiration-page">
  <div class="inspiration-header">
    <h1 class="inspiration-title">Mood Board</h1>
    <p class="inspiration-style-echo">Your pinned editorial references — separate from your closet.</p>
  </div>

  <% if @pins.any? %>
    <div class="inspo-results">
      <% @pins.each do |pin| %>
        <div class="inspo-card">
          <div class="inspo-palette-bar">
            <% pin.color_palette_array.each do |color| %>
              <span class="inspo-swatch" style="background-color: <%= color %>;"></span>
            <% end %>
          </div>

          <div class="inspo-body">
            <p class="inspo-reference"><%= pin.editorial_reference %></p>
            <h2 class="inspo-concept-title"><%= pin.title %></h2>
            <p class="inspo-description"><%= pin.description %></p>

            <div class="inspo-pieces">
              <% pin.key_pieces_array.each do |piece| %>
                <span class="inspo-piece-chip"><%= piece %></span>
              <% end %>
            </div>

            <p class="inspo-timeless-note"><%= pin.why_timeless %></p>

            <form action="/unpin-inspiration/<%= pin.id %>" method="post" class="mt-3" onsubmit="return confirm('Remove this pin?')">
              <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
              <button type="submit" class="btn btn-sm inspo-unpin-btn">Unpin</button>
            </form>
          </div>
        </div>
      <% end %>
    </div>

  <% else %>
    <div class="inspo-empty">
      <p>Nothing pinned yet.</p>
      <p><a href="/inspiration">Get inspired</a> and pin looks that resonate.</p>
    </div>
  <% end %>
</div>
